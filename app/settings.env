# Pengaturan TAIDEN. Edit, simpan, lalu jalankan ulang aplikasi.
# Baris berawalan # diabaikan.

# --- Mode OFFLINE (default, tanpa internet, tanpa biaya) ---
AI_MODE=local
# Bahasa yang diucapkan pembicara: en = Inggris, id = Indonesia, auto = deteksi
SRC_LANG=en

# --- Mode ONLINE Gemini (opsional) ---
# Untuk memakai: ubah AI_MODE di atas menjadi kosong (AI_MODE=) lalu isi kunci di bawah
GEMINI_API_KEY=
